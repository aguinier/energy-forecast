.superpowers/

# Generated by scripts/evaluate_net_position.py on every scheduled run
reports/net_position_eval/
# Generated by scripts/evaluate_scorecard.py; the dated ABL-129 evidence is
# force-added once, while recurring local refreshes remain untracked.
reports/forecast_scorecard/

# Generated by scripts/compare_experiments.py on every comparison run; no
# experiment's results.json has ever been committed (ABL-196).
experiments/*/results.json
# Reproducible experiment artifacts stay local/mounted like production models;
# evidence packs record their SHA-256 without putting binary models in Git.
experiments/*/artifacts/
